{
  "name": "nooxshell",
  "version": "1.0.0",
  "description": "Floating island desktop shell for Omarchy, built on Quickshell.",

  "shell": {
    "configPath": "~/.config/quickshell",
    "root": "shell.qml",
    "ipcPath": "~/.config/quickshell"
  },

  "state": {
    "dir": "~/.local/state/nooxshell",
    "manifest": "state.json",
    "backupDir": "backups",
    "backupManifest": "backup_manifest.json"
  },

  "dependencies": {
    "pacman": [
      "quickshell",
      "hyprland",
      "omarchy",
      "networkmanager",
      "wireplumber",
      "libpulse",
      "upower",
      "brightnessctl",
      "jq",
      "fontconfig"
    ],
    "commands": {
      "qs": "quickshell",
      "hyprctl": "hyprland",
      "nmcli": "networkmanager",
      "wpctl": "wireplumber",
      "pactl": "libpulse",
      "upower": "upower",
      "brightnessctl": "brightnessctl",
      "jq": "jq",
      "fc-cache": "fontconfig"
    }
  },

  "files": [
    { "src": "shell.qml", "dest": "~/.config/quickshell/shell.qml" },
    { "src": "AppSearch.js", "dest": "~/.config/quickshell/AppSearch.js" },
    { "src": "AudioBar.qml", "dest": "~/.config/quickshell/AudioBar.qml" },
    { "src": "config.toml", "dest": "~/.config/quickshell/config.toml", "preserve": true },
    { "src": "BarVariants.qml", "dest": "~/.config/quickshell/BarVariants.qml" },
    { "src": "BatteryBar.qml", "dest": "~/.config/quickshell/BatteryBar.qml" },
    { "src": "BluetoothBar.qml", "dest": "~/.config/quickshell/BluetoothBar.qml" },
    { "src": "BluetoothModel.js", "dest": "~/.config/quickshell/BluetoothModel.js" },
    { "src": "BrightnessBar.qml", "dest": "~/.config/quickshell/BrightnessBar.qml" },
    { "src": "ConfirmDialog.qml", "dest": "~/.config/quickshell/ConfirmDialog.qml" },
    { "src": "CursorXRay.qml", "dest": "~/.config/quickshell/CursorXRay.qml" },
    { "src": "MenuModel.js", "dest": "~/.config/quickshell/MenuModel.js" },
    { "src": "NotificationLogic.js", "dest": "~/.config/quickshell/NotificationLogic.js" },
    { "src": "NotificationPanel.qml", "dest": "~/.config/quickshell/NotificationPanel.qml" },
    { "src": "OmarchyMenu.qml", "dest": "~/.config/quickshell/OmarchyMenu.qml" },
    { "src": "PopoutCoordinator.qml", "dest": "~/.config/quickshell/PopoutCoordinator.qml" },
    { "src": "RoundedOverlay.qml", "dest": "~/.config/quickshell/RoundedOverlay.qml" },
    { "src": "ScoopContour.qml", "dest": "~/.config/quickshell/ScoopContour.qml" },
    { "src": "ScoopShape.qml", "dest": "~/.config/quickshell/ScoopShape.qml" },
    { "src": "ScoopTestPanel.qml", "dest": "~/.config/quickshell/ScoopTestPanel.qml" },
    { "src": "ScoopV2.qml", "dest": "~/.config/quickshell/ScoopV2.qml" },
    { "src": "Theme.qml", "dest": "~/.config/quickshell/Theme.qml" },
    { "src": "GridPicker.qml", "dest": "~/.config/quickshell/GridPicker.qml" },
    { "src": "ThemePicker.qml", "dest": "~/.config/quickshell/ThemePicker.qml" },
    { "src": "TimeBar.qml", "dest": "~/.config/quickshell/TimeBar.qml" },
    { "src": "ToggleBar.qml", "dest": "~/.config/quickshell/ToggleBar.qml" },
    { "src": "ToggleState.qml", "dest": "~/.config/quickshell/ToggleState.qml" },
    { "src": "WallpaperPicker.qml", "dest": "~/.config/quickshell/WallpaperPicker.qml" },
    { "src": "WifiBar.qml", "dest": "~/.config/quickshell/WifiBar.qml" },
    { "src": "WifiModel.js", "dest": "~/.config/quickshell/WifiModel.js" },
    { "src": "WorkspaceBar.qml", "dest": "~/.config/quickshell/WorkspaceBar.qml" },
    { "src": "decorations/airplane.svg", "dest": "~/.config/quickshell/decorations/airplane.svg" },
    { "src": "decorations/bell-fill.svg", "dest": "~/.config/quickshell/decorations/bell-fill.svg" },
    { "src": "decorations/bell-slash-fill.svg", "dest": "~/.config/quickshell/decorations/bell-slash-fill.svg" },
    { "src": "decorations/bell-slash.svg", "dest": "~/.config/quickshell/decorations/bell-slash.svg" },
    { "src": "decorations/bell.svg", "dest": "~/.config/quickshell/decorations/bell.svg" },
    { "src": "decorations/bluetooth.svg", "dest": "~/.config/quickshell/decorations/bluetooth.svg" },
    { "src": "decorations/bluetoothidle.svg", "dest": "~/.config/quickshell/decorations/bluetoothidle.svg" },
    { "src": "decorations/coffee.svg", "dest": "~/.config/quickshell/decorations/coffee.svg" },
    { "src": "decorations/corner-center.svg", "dest": "~/.config/quickshell/decorations/corner-center.svg" },
    { "src": "decorations/corner-left.svg", "dest": "~/.config/quickshell/decorations/corner-left.svg" },
    { "src": "decorations/corner-right.svg", "dest": "~/.config/quickshell/decorations/corner-right.svg" },
    { "src": "decorations/cursor.svg", "dest": "~/.config/quickshell/decorations/cursor.svg" },
    { "src": "decorations/cursor-fill.svg", "dest": "~/.config/quickshell/decorations/cursor-fill.svg" },
    { "src": "decorations/function.svg", "dest": "~/.config/quickshell/decorations/function.svg" },
    { "src": "decorations/gauge.svg", "dest": "~/.config/quickshell/decorations/gauge.svg" },
    { "src": "decorations/lightning-fill-red.svg", "dest": "~/.config/quickshell/decorations/lightning-fill-red.svg" },
    { "src": "decorations/lightning-fill.svg", "dest": "~/.config/quickshell/decorations/lightning-fill.svg" },
    { "src": "decorations/microphone-fill.svg", "dest": "~/.config/quickshell/decorations/microphone-fill.svg" },
    { "src": "decorations/microphone-slash-fill.svg", "dest": "~/.config/quickshell/decorations/microphone-slash-fill.svg" },
    { "src": "decorations/microphone-slash.svg", "dest": "~/.config/quickshell/decorations/microphone-slash.svg" },
    { "src": "decorations/microphone.svg", "dest": "~/.config/quickshell/decorations/microphone.svg" },
    { "src": "decorations/moon.svg", "dest": "~/.config/quickshell/decorations/moon.svg" },
    { "src": "decorations/qr-code.svg", "dest": "~/.config/quickshell/decorations/qr-code.svg" },
    { "src": "decorations/signal.svg", "dest": "~/.config/quickshell/decorations/signal.svg" },
    { "src": "bin/cursor-tracker", "dest": "~/.config/quickshell/bin/cursor-tracker" },
    { "src": "bin/cursor-tracker.py", "dest": "~/.config/quickshell/bin/cursor-tracker.py" },
    { "src": "bin/picker-common.sh", "dest": "~/.config/quickshell/bin/picker-common.sh" },
    { "src": "bin/picker-wallpapers", "dest": "~/.config/quickshell/bin/picker-wallpapers" },
    { "src": "bin/picker-themes", "dest": "~/.config/quickshell/bin/picker-themes" },
    { "src": "bin/picker-set-background", "dest": "~/.config/quickshell/bin/picker-set-background" },
    { "src": "bin/picker-set-theme", "dest": "~/.config/quickshell/bin/picker-set-theme" }
  ],

  "shims": [
    { "src": "shims/omarchy", "dest": "~/.local/bin/omarchy", "mode": "0755" },
    { "src": "shims/omarchy-audio-output-volume", "dest": "~/.local/bin/omarchy-audio-output-volume", "mode": "0755" },
    { "src": "shims/omarchy-brightness-display", "dest": "~/.local/bin/omarchy-brightness-display", "mode": "0755" },
    { "src": "shims/omarchy-brightness-display-ddc", "dest": "~/.local/bin/omarchy-brightness-display-ddc", "mode": "0755" },
    { "src": "shims/omarchy-menu", "dest": "~/.local/bin/omarchy-menu", "mode": "0755" },
    { "src": "shims/omarchy-menu-input", "dest": "~/.local/bin/omarchy-menu-input", "mode": "0755" },
    { "src": "shims/omarchy-menu-select", "dest": "~/.local/bin/omarchy-menu-select", "mode": "0755" },
    { "src": "shims/_omarchy-menu-shim", "dest": "~/.local/bin/_omarchy-menu-shim", "mode": "0644" },
    { "src": "shims/omarchy-osd", "dest": "~/.local/bin/omarchy-osd", "mode": "0755" },
    { "src": "shims/omarchy-shell", "dest": "~/.local/bin/omarchy-shell", "mode": "0755" },
    { "src": "shims/omarchy-theme-bg-next", "dest": "~/.local/bin/omarchy-theme-bg-next", "mode": "0755" },
    { "src": "shims/omarchy-theme-bg-boot-intro", "dest": "~/.local/bin/omarchy-theme-bg-boot-intro", "mode": "0755" }
  ],

  "retiredShims": [
    "~/.local/bin/awww-omarchy-bridge",
    "~/.local/bin/omarchy-theme-bg-set",
    "~/.local/bin/omarchy-theme-bg-switcher",
    "~/.local/bin/omarchy-menu-images"
  ],

  "hypr": {
    "module": {
      "src": "hypr/quickshell-islands.lua",
      "dest": "~/.config/hypr/quickshell-islands.lua"
    },
    "require": {
      "file": "~/.config/hypr/hyprland.lua",
      "line": "require(\"hypr.quickshell-islands\")",
      "marker": "-- quickshell-islands:begin"
    }
  },

  "omarchy": {
    "shellConfig": "~/.config/omarchy/shell.json",
    "disablePlugins": [
      "omarchy.audio",
      "omarchy.menu",
      "omarchy.notifications"
    ],
    "enablePlugins": [
      "omarchy.background"
    ]
  },

  "cli": {
    "src": "bin/nooxshell",
    "dest": "~/.local/bin/nooxshell",
    "mode": "0755"
  },

  "theme": {
    "name": "nooxnpaints",
    "label": "Nooxnpaints",
    "repo": "https://github.com/whonoox/omarchy-nooxnpaints-theme.git"
  },

  "hooks": {
    "post_install": [
      "hyprctl reload",
      "nooxshell restart"
    ]
  }
}
