#!/usr/bin/env bash
# nooxshell — management CLI for the Quickshell island desktop shell.
#
# Every operation is scoped to this shell's own config path. The stock
# Omarchy shell runs as a separate Quickshell instance
# (/usr/share/omarchy/shell), so a bare `qs kill` or an unqualified
# `qs ipc call` would reach the wrong instance. Every command below passes
# --path explicitly for that reason.

set -euo pipefail

QS_PATH="${OMARCHY_ISLANDS_QS_PATH:-$HOME/.config/quickshell}"
IPC_TIMEOUT="${OMARCHY_ISLANDS_IPC_TIMEOUT:-3s}"

# Friendly name -> IPC target. Verified against `qs ipc show` for this
# config; a target that does not exist answers "Target not found.".
declare -A IPC_TARGETS=(
  [menu]="omarchyMenu"
  [wifi]="wifiBar"
  [bluetooth]="bluetoothBar"
  [time]="timeBar"
  [audio]="audioBar"
  [battery]="batteryBar"
  [brightness]="brightnessBar"
  [wallpaper]="wallpaperPicker"
  [theme]="themePicker"
  [notifications]="notifications"
)

# The menu is routed by route, not by a plain toggle: its handler takes the
# route as a required argument and opens the root menu by default.
declare -A IPC_DEFAULT_ARGS=(
  [menu]="root"
)

# Modules whose handler is not named "toggle".
declare -A IPC_FUNCTIONS=(
  [notifications]="toggleDnd"
)

fail() {
  echo "nooxshell: $*" >&2
  exit 1
}

warn() {
  echo "nooxshell: $*" >&2
}

usage() {
  cat <<'USAGE'
Usage: nooxshell <command> [options]

Commands:
  start                Start the island shell if it is not already running
  stop                 Stop this shell's Quickshell instance
  restart              Stop and start again
  log [-f] [-n N]      Show shell logs; -f follows, -n limits to N lines
  status               Show instance, IPC health and available targets
  doctor [--fix]       Check for stray instances and theme problems
  toggle <module>      Toggle an island panel
  ping                 Check that the shell answers over IPC
  update               Pull the newest revision and restart the shell
  uninstall            Remove the shell and restore the stock desktop
  help                 Show this help

Modules: menu, wifi, bluetooth, time, audio, battery, brightness,
         wallpaper, theme, notifications

Environment:
  OMARCHY_ISLANDS_QS_PATH       Config path (default ~/.config/quickshell)
  OMARCHY_ISLANDS_IPC_TIMEOUT   IPC timeout (default 3s)
USAGE
}

# Prints the PID of the instance serving our config path, if any.
# The path is named explicitly: without it, qs list falls back to the
# "default" configuration, which is only the islands shell by coincidence of
# the install layout.
instance_pid() {
  # The status is discarded: qs may exit non-zero when the instance is
  # gone, and under pipefail that would abort the caller. An empty result
  # already means "not running".
  qs list -p "$QS_PATH" 2>/dev/null |
    awk -v path="$QS_PATH/shell.qml" '
      /^Instance / { pid = ""; config = ""; next }
      /Process ID:/ { pid = $3; next }
      /Config path:/ { config = $3; next }
      /^$/ { if (config == path && pid != "") { print pid; exit } }
    ' || true
}

# Lists "pid config" for every running Quickshell instance that is not
# serving our config path. The stock Omarchy shell at
# /usr/share/omarchy/shell is expected and is not reported.
list_other_instances() {
  # As in instance_pid: the status is discarded so a failure to list
  # instances does not abort the caller.
  qs list --all 2>/dev/null |
    awk -v path="$QS_PATH/shell.qml" -v stock="/usr/share/omarchy/shell/shell.qml" '
      /^Instance / { pid = ""; config = ""; next }
      /Process ID:/ { pid = $3; next }
      /Config path:/ { config = $3; next }
      /^$/ {
        if (config != "" && config != path && config != stock && pid != "")
          print pid, config
      }
    ' || true
}

# Calls an IPC function on our instance and echoes the reply. The reply text
# is checked, not the exit status: `qs ipc call` exits 0 even when it prints
# "Target not found." or "Function not found.".
ipc_call() {
  local target="$1"
  shift
  timeout --kill-after=1s "$IPC_TIMEOUT" \
    qs ipc -n -p "$QS_PATH" call -- "$target" "$@" 2>/dev/null || true
}

cmd_doctor() {
  local pid
  pid="$(instance_pid)"

  echo "config:   $QS_PATH/shell.qml"
  if [[ -n $pid ]]; then
    echo "instance: running (pid $pid)"
  else
    echo "instance: not running"
  fi

  local ping_reply
  ping_reply="$(ipc_call "${IPC_TARGETS[menu]}" ping)"
  if [[ $ping_reply == "ok" ]]; then
    echo "ipc:      responsive"
  else
    echo "ipc:      not responding${ping_reply:+ ($ping_reply)}"
  fi

  # The X-Ray effect needs the global decoration blur. A layer rule
  # asking for xray does nothing while decoration:blur:enabled is false,
  # so the panels render flat with no frosted edge.
  local blur_state
  blur_state="$(hyprctl getoption decoration:blur:enabled 2>/dev/null | head -1)"
  if [[ $blur_state == "bool: true"* ]]; then
    echo "xray:     decoration blur enabled"
  else
    echo "xray:     decoration blur is DISABLED"
    echo "          the islands will render flat, with no frosted edge"
    echo "          fix with: hyprctl reload  (the shell's Hyprland module sets it)"
  fi

  # The theme file is what makes the panels use the live Omarchy palette.
  # An instance whose HOME does not have it falls back to the hardcoded
  # default colors, which is the visible symptom of a stray instance.
  local theme="$HOME/.local/state/omarchy/current/theme/colors.toml"
  if [[ -f $theme ]]; then
    echo "theme:    $theme"
  else
    echo "theme:    MISSING at $theme"
    echo "          panels would use the default palette instead of the live theme"
  fi

  # The brand font is installed system-wide, not shipped with the shell.
  # Theme.qml falls back to the system font when it is absent.
  #
  # The count is taken with awk, which always succeeds: `grep -c` exits 1
  # when it finds nothing, and under set -e that would abort the command
  # on a machine without the font.
  local brand_count
  brand_count="$(fc-list 2>/dev/null | awk -v f=": Nuuxfont:" 'index($0, f) { c++ } END { print c + 0 }')"
  if (( brand_count > 0 )); then
    echo "font:     Nuuxfont"
  else
    echo "font:     Nuuxfont not installed; using the system font"
  fi

  local others
  others="$(list_other_instances)"

  if [[ -z $others ]]; then
    echo "strays:   none"
    return 0
  fi

  echo "strays:   found"
  local config
  while read -r pid config; do
    [[ -n $pid ]] || continue
    echo "  pid $pid  $config"
  done <<<"$others"

  if [[ ${1:-} == "--fix" ]]; then
    while read -r pid config; do
      [[ -n $pid ]] || continue
      qs kill --pid "$pid" >/dev/null 2>&1 || kill "$pid" 2>/dev/null || true
      echo "  stopped pid $pid"
    done <<<"$others"
  else
    echo
    echo "A stray instance draws a second set of panels over the desktop."
    echo "Stop them with: nooxshell doctor --fix"
  fi
}

cmd_status() {
  if [[ ! -f $QS_PATH/shell.qml ]]; then
    echo "config:  $QS_PATH/shell.qml (missing)"
    return 1
  fi

  local pid
  pid="$(instance_pid)"

  echo "config:  $QS_PATH/shell.qml"
  if [[ -n $pid ]]; then
    echo "instance: running (pid $pid)"
  else
    echo "instance: not running"
  fi

  local ping_reply
  ping_reply="$(ipc_call "${IPC_TARGETS[menu]}" ping)"
  if [[ $ping_reply == "ok" ]]; then
    echo "ipc:      responsive"
  else
    echo "ipc:      not responding${ping_reply:+ ($ping_reply)}"
  fi

  # The target list is best-effort. `timeout` returns 124 when it has to
  # kill qs, and under pipefail that would abort the command, so the
  # status is discarded and the (possibly empty) output is used.
  local targets
  targets="$(timeout --kill-after=1s "$IPC_TIMEOUT" qs ipc -n -p "$QS_PATH" show 2>/dev/null | awk '/^target /{print $2}' || true)"
  if [[ -n $targets ]]; then
    echo "targets:  $(echo "$targets" | tr '\n' ' ')"
  fi

  report_foreign_instances
}

# Any other Quickshell instance drawing island panels over the desktop
# shows up as a second set of panels, often with the wrong colors because
# its HOME does not point at the live Omarchy theme. List them so the
# duplication is visible instead of a mystery.
report_foreign_instances() {
  local others
  others="$(list_other_instances)"

  if [[ -z $others ]]; then
    return 0
  fi

  echo
  echo "WARNING: other Quickshell instances are running:"
  local pid config
  while read -r pid config; do
    [[ -n $pid ]] || continue
    echo "  pid $pid  $config"
  done <<<"$others"

  echo
  echo "These draw a second set of panels over the desktop. Stop them with:"
  echo "  qs kill --pid <pid>"
}

cmd_start() {
  if [[ -n $(instance_pid) ]]; then
    echo "nooxshell: already running (pid $(instance_pid))"
    start_wallpaper_bridge
    return 0
  fi
  [[ -f $QS_PATH/shell.qml ]] || fail "no shell at $QS_PATH/shell.qml"

  # -d detaches so the shell outlives this command; -n keeps a second
  # instance from racing us.
  #
  # Right after a kill, the old instance's lock is still registered for a
  # moment and `qs -n` refuses to start with "An instance of this
  # configuration is already running.". Retry until the lock clears.
  local launched=0
  local waited=0
  while (( waited < 100 )); do
    if qs -d -n -p "$QS_PATH" >/dev/null 2>&1; then
      launched=1
      break
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  (( launched )) || fail "could not start the shell; another instance may still be running"

  waited=0
  while (( waited < 100 )); do
    if [[ $(ipc_call "${IPC_TARGETS[menu]}" ping) == "ok" ]]; then
      echo "nooxshell: started (pid $(instance_pid))"
      start_wallpaper_bridge
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done

  fail "shell did not answer over IPC; check 'nooxshell log'"
}

# The wallpaper is drawn by awww, kept in sync with Omarchy's background
# symlink by the bridge. The bridge is started by the Hyprland module at
# session start, which does not happen on a reload, so after an install
# the wallpaper would stay black until the next login.
start_wallpaper_bridge() {
  local bridge="$HOME/.local/bin/awww-omarchy-bridge"
  local pid_file="$HOME/.local/state/nooxshell/awww-bridge.pid"

  [[ -x $bridge ]] || return 0

  # The bridge records its pid, so a running one is found by asking the
  # process directly. Matching on the command line would also match any
  # other process that merely mentions the name.
  if [[ -f $pid_file ]]; then
    local pid
    pid="$(cat "$pid_file" 2>/dev/null)"
    if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi

  setsid -f "$bridge" >/dev/null 2>&1 || true

  # Give it a moment to come up, then confirm it is running.
  local waited=0
  while (( waited < 30 )); do
    if [[ -f $pid_file ]]; then
      local pid
      pid="$(cat "$pid_file" 2>/dev/null)"
      if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
        return 0
      fi
    fi
    sleep 0.1
    waited=$((waited + 1))
  done

  warn "could not start the wallpaper bridge; the wallpaper may stay black"
  return 0
}

cmd_stop() {
  local pid
  pid="$(instance_pid)"
  [[ -n $pid ]] || {
    echo "nooxshell: not running"
    return 0
  }

  qs kill -p "$QS_PATH" >/dev/null 2>&1 || kill "$pid" 2>/dev/null || true

  # Wait for the instance to disappear from the registry. Starting a new one
  # too early fails with "An instance of this configuration is already
  # running.", because the old lock is still registered.
  local waited=0
  while (( waited < 100 )) && [[ -n $(instance_pid) ]]; do
    sleep 0.1
    waited=$((waited + 1))
  done

  echo "nooxshell: stopped"
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_log() {
  local follow=0
  local lines=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f | --follow)
        follow=1
        shift
        ;;
      -n)
        lines="${2:-0}"
        shift 2
        ;;
      *)
        fail "unknown log option: $1"
        ;;
    esac
  done

  local args=(-n -p "$QS_PATH")
  (( follow )) && args+=(-f)
  (( lines > 0 )) && args+=(-t "$lines")

  qs log "${args[@]}"
}

cmd_toggle() {
  local module="${1:-}"
  [[ -n $module ]] || fail "toggle needs a module name"

  local target="${IPC_TARGETS[$module]:-}"
  [[ -n $target ]] || fail "unknown module '$module' (try 'nooxshell help')"

  local -a args=("${IPC_FUNCTIONS[$module]:-toggle}")
  local default_arg="${IPC_DEFAULT_ARGS[$module]:-}"
  [[ -n $default_arg ]] && args+=("$default_arg")

  local reply
  reply="$(ipc_call "$target" "${args[@]}")"
  case "$reply" in
    "Target not found." | "Function not found.")
      fail "$module: $reply"
      ;;
    *)
      # A void handler answers with an empty string; that is a success.
      # The "if" form matters: a bare `[[ -n $reply ]] && echo` would be
      # the last statement of the function, and its non-zero status would
      # abort the script under set -e.
      if [[ -n $reply ]]; then
        echo "$reply"
      fi
      ;;
  esac
}

cmd_ping() {
  local reply
  reply="$(ipc_call "${IPC_TARGETS[menu]}" ping)"
  [[ $reply == "ok" ]] || fail "no answer from ${QS_PATH} ($reply)"
  echo "ok"
}

# The directory holding the installer and uninstaller. The state file
# records where the shell was installed from, which is the only place
# those scripts exist: the manifest deploys the shell files, not the
# scripts that manage them.
installer_repo() {
  # An explicit override wins.
  if [[ -n ${OMARCHY_ISLANDS_REPO:-} && -f $OMARCHY_ISLANDS_REPO/install.sh ]]; then
    printf '%s' "$OMARCHY_ISLANDS_REPO"
    return 0
  fi

  local recorded=""
  if [[ -f "$HOME/.local/state/nooxshell/state.json" ]]; then
    recorded="$(jq -r '.repo // empty' "$HOME/.local/state/nooxshell/state.json" 2>/dev/null || true)"
  fi

  if [[ -n $recorded && -f $recorded/install.sh ]]; then
    printf '%s' "$recorded"
    return 0
  fi

  if [[ -f $QS_PATH/install.sh ]]; then
    printf '%s' "$QS_PATH"
    return 0
  fi

  return 1
}

cmd_update() {
  local repo
  repo="$(installer_repo)" ||
    fail "no installer found; re-run the one-liner install to restore it"

  if [[ -d $repo/.git ]]; then
    # A dirty tree means the user has local edits that a pull could
    # conflict with. Say so plainly instead of surfacing git's error.
    if [[ -n $(git -C "$repo" status --porcelain) ]]; then
      warn "uncommitted changes in $repo; commit or stash them before updating"
    fi
    git -C "$repo" pull --ff-only || fail "git pull failed in $repo"
  else
    echo "nooxshell: $repo is not a git checkout; skipping pull"
  fi

  local installer="$repo/install.sh"
  [[ -f $installer ]] || fail "no installer at $installer"
  bash "$installer" --skip-deps

  cmd_restart
}

cmd_uninstall() {
  local repo
  repo="$(installer_repo)" || {
    # The installer is gone, so the uninstaller cannot be run from it.
    # The one-liner uninstall fetches a copy.
    echo "nooxshell: no installer found; fetching the uninstaller" >&2
    bash <(curl -fsSL "${NOOXSHELL_REPO_URL:-https://github.com/whonoox/quickshell.git}/raw/${NOOXSHELL_REPO_REF:-master}/uninstall.sh")
    return
  }

  bash "$repo/uninstall.sh"
}

main() {
  local command="${1:-help}"
  [[ $# -gt 0 ]] && shift

  case "$command" in
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    log) cmd_log "$@" ;;
    status) cmd_status "$@" ;;
    doctor) cmd_doctor "$@" ;;
    toggle) cmd_toggle "$@" ;;
    ping) cmd_ping "$@" ;;
    update) cmd_update "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    help | -h | --help) usage ;;
    *)
      echo "nooxshell: unknown command '$command'" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
