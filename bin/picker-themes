#!/bin/bash
# Lists the installed themes for the theme picker.
#
# Usage: picker-themes <screen-size, e.g. 1920x1080>
#
# Output, tab separated:
#   CURRENT <theme> <background-still>
#   <theme> <thumbnail> <still> <landing>
#
# The thumbnail is the theme's preview, shown on its grid card. <landing>
# is the background `omarchy theme set` would pick for the theme, chosen
# the way omarchy-theme-set chooses it, as the path the background link
# will point at once the theme is applied. <still> is the image the
# picker's zoom ends on: the first frame of that background's intro when
# it has one and intros are on, otherwise the background itself (empty
# for a video background, which then falls back to the thumbnail).

source "$(dirname "$(readlink -f "$0")")/picker-common.sh"

# Globs rather than find, for the same reason the helpers avoid subshells.
shopt -s nullglob nocaseglob

screen="${1:-1920x1080}"
card="880x496"
omarchy_path="${OMARCHY_PATH:-/usr/share/omarchy}"
current_theme_bgs="$state_dir/current/theme/backgrounds"
current_theme=$(<"$state_dir/current/theme.name")
current_link_target=$(readlink "$current_link" 2>/dev/null)
intros=false
intros_enabled && intros=true

current_still=""
current_bg=$(readlink -f "$current_link" 2>/dev/null)
if [[ -f $current_bg ]] && ! is_video "$current_bg"; then
  displayable "$current_bg" "$screen"
  current_still="$REPLY"
fi
printf 'CURRENT\t%s\t%s\n' "$current_theme" "$current_still"

# REPLY = the theme's preview image.
find_preview() {
  local theme_path="$1" ext file
  REPLY=""
  for ext in png jpg jpeg webp gif bmp jxl; do
    for file in "$theme_path"/preview."$ext"; do
      [[ -f $file ]] && { REPLY="$file"; return; }
    done
  done
  for file in "$theme_path"/backgrounds/*; do
    [[ -f $file ]] && is_image "$file" && { REPLY="$file"; return; }
  done
}

# names = the background file names in the given directories, sorted and
# deduplicated: the media omarchy-theme-set picks from (no .jxl).
media_names() {
  local dir file
  names=()
  for dir in "$@"; do
    for file in "$dir"/*; do
      [[ -f $file && ${file,,} != *.jxl ]] && { is_image "$file" || is_video "$file"; } && names+=("${file##*/}")
    done
  done
  # Each directory's glob is already sorted; only a merge of two needs sort.
  if (( $# > 1 && ${#names[@]} > 0 )); then
    mapfile -t names < <(printf '%s\n' "${names[@]}" | sort -u)
  fi
}

# landing_source / landing_link = the background the theme lands on.
# Mirrors choose_theme_background in omarchy-theme-set: the user's own
# backgrounds for the theme sort ahead of the theme's, re-applying the
# current theme moves on to its next background, and another theme returns
# to the background it was last left on. The link is where the background
# link will point; the source is the file that will be once the theme is
# staged, the user's copy of a theme overlaying the stock one.
choose_landing() {
  local theme="$1" user_dir="$HOME/.config/omarchy/backgrounds/$1"
  local user_theme="$HOME/.config/omarchy/themes/$1/backgrounds" stock_theme="$omarchy_path/themes/$1/backgrounds"
  local -a candidates=() names=()
  local name link="" remembered="" i index=-1

  landing_source=""
  landing_link=""

  media_names "$user_dir"
  for name in "${names[@]}"; do candidates+=("$user_dir/$name"); done
  if [[ -d $user_theme ]]; then media_names "$user_theme" "$stock_theme"; else media_names "$stock_theme"; fi
  for name in "${names[@]}"; do candidates+=("$current_theme_bgs/$name"); done
  (( ${#candidates[@]} > 0 )) || return 0

  if [[ $theme == "$current_theme" ]]; then
    for i in "${!candidates[@]}"; do
      [[ ${candidates[$i]} == "$current_link_target" ]] && { index=$i; break; }
    done
    if (( index != -1 )); then
      link="${candidates[$(( (index + 1) % ${#candidates[@]} ))]}"
    else
      link="${candidates[0]}"
    fi
  else
    [[ -f $state_dir/theme-backgrounds/$theme ]] && remembered=$(<"$state_dir/theme-backgrounds/$theme")
    link="${candidates[0]}"
    if [[ ${remembered%/*} == "$current_theme_bgs" ]]; then
      name=${remembered##*/}
      [[ -f $user_theme/$name || -f $stock_theme/$name ]] && link="$current_theme_bgs/$name"
    elif [[ -n $remembered && -f $remembered ]]; then
      link="$remembered"
    fi
  fi

  landing_link="$link"
  landing_source="$link"
  if [[ ${link%/*} == "$current_theme_bgs" && $theme != "$current_theme" ]]; then
    name=${link##*/}
    if [[ -f $user_theme/$name ]]; then
      landing_source="$user_theme/$name"
    else
      landing_source="$stock_theme/$name"
    fi
  fi
}

declare -A seen=()
for dir in "$HOME/.config/omarchy/themes" "$omarchy_path/themes"; do
  [[ -d $dir ]] || continue
  for theme_path in "$dir"/*/; do
    theme_path="${theme_path%/}"
    name="${theme_path##*/}"
    [[ -z ${seen[$name]:-} ]] || continue
    seen[$name]=1

    find_preview "$theme_path"
    [[ -n $REPLY ]] || continue
    displayable "$REPLY" "$card"
    thumb="$REPLY"

    choose_landing "$name"
    still=""
    if [[ -f $landing_source ]] && ! is_video "$landing_source"; then
      # picker-set-background plays the intro whenever it sets the
      # background, the current theme included.
      if [[ $intros == true ]]; then
        resolve_intro "$landing_source"
        [[ -n $REPLY ]] && intro_first_frame "$REPLY" "$screen" && still="$REPLY"
      fi
      if [[ -z $still ]]; then
        displayable "$landing_source" "$screen"
        still="$REPLY"
      fi
    fi

    printf '%s\t%s\t%s\t%s\n' "$name" "$thumb" "$still" "$landing_link"
  done
done
