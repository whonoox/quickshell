#!/bin/bash
# Pass-through wrapper for the omarchy CLI.
#
# The real /usr/bin/omarchy derives OMARCHY_BIN_DIR from its own location, so
# `omarchy menu ...` always dispatches to /usr/bin/omarchy-menu -- even though
# ~/.local/bin/omarchy-menu shadows it for direct calls, which would otherwise
# make the two spellings open different menus.
#
# Only the `menu` group is re-routed here; every other subcommand is handed
# straight to the packaged binary with its arguments untouched, and omarchy-menu
# still falls back to the packaged menu when this quickshell instance is down.

set -euo pipefail

# Resolved relative to this script, like the other shims, so the set keeps
# working wherever it is installed rather than only under ~/.local/bin.
here="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"

if [[ ${1-} == menu && ${2-} == images ]]; then
  shift 2
  exec "$here/omarchy-menu-images" "$@"
fi

if [[ ${1-} == menu && ${2-} == select ]]; then
  shift 2
  exec "$here/omarchy-menu-select" "$@"
fi

if [[ ${1-} == menu && ${2-} == input ]]; then
  shift 2
  exec "$here/omarchy-menu-input" "$@"
fi

if [[ ${1-} == menu ]]; then
  shift
  exec "$here/omarchy-menu" "$@"
fi

if [[ ${1-} == theme && ${2-} == bg && ${3-} == next ]]; then
  shift 3
  exec "$here/omarchy-theme-bg-next" "$@"
fi

exec /usr/bin/omarchy "$@"
