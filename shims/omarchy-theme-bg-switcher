#!/usr/bin/env bash
# omarchy:summary=Open the Quickshell wallpaper picker
# omarchy:group=theme
# omarchy:name=bg-switcher
# omarchy:args=[]
# omarchy:examples=omarchy theme bg-switcher

# Shadow of /usr/share/omarchy/bin/omarchy-theme-bg-switcher. Summons this
# user's own Quickshell wallpaper grid instead of the stock switcher, so the
# picker matches the rest of the islands.

set -euo pipefail

QS_PATH="${NOTIFICATION_QS_PATH:-$HOME/.config/quickshell}"

if [[ ! -f $QS_PATH/shell.qml ]]; then
  echo "omarchy-theme-bg-switcher: quickshell config not found: $QS_PATH/shell.qml" >&2
  exit 1
fi

timeout --kill-after=1s "${OMARCHY_SHELL_IPC_TIMEOUT:-2s}" \
  qs ipc -n -p "$QS_PATH" call -- wallpaperPicker toggle >/dev/null 2>&1
